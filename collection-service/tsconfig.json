{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "paths": {
      "shared/*": ["../shared/dist/*"],
      "shared": ["../shared/dist/types"]
    }
  },
  "references": [
    { "path": "../shared" }
  ],
  "include": ["src/**/*"]
}
