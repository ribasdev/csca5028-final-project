    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^2.5.0",
    "ioredis": "^5.3.2",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.9",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.0"
  }
}
