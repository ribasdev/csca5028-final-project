{
  "name": "alert-service",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "node dist/index.js",
